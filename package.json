{
  "name": "zuhausebleiben-kompass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node generate.mjs && node scripts/build-checklists.mjs",
    "build:launch": "node generate.mjs --index && node scripts/build-checklists.mjs --index",
    "test:consent": "playwright test",
    "test:measurement": "node build-measurement.mjs && node --test tests/measurement-policy.test.mjs",
    "test": "npm run build && npm run build:launch && python3 test_site.py && python3 test_articles.py && python3 test_cross_links.py && npm run build && npm run test:measurement && npm run test:consent && npm run test:partner",
    "test:partner": "python3 test_partner_links.py"
  },
  "dependencies": {
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
